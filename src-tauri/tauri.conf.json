{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LiteDoc Browser",
  "version": "0.1.2",
  "identifier": "com.local.litedoc-browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteDoc Browser",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DESKTOP/**",
          "$DOCUMENT/**",
          "$DOWNLOAD/**",
          "$HOME/**",
          "/Users/**",
          "/Volumes/**",
          "/private/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon-1024.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "html", "htm", "txt", "text"],
        "name": "LiteDoc Browser Document",
        "description": "Open with LiteDoc Browser"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0"
    }
  }
}
