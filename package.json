{
  "name": "litedoc-browser",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop-run.mjs dev",
    "desktop:build": "node scripts/desktop-run.mjs build",
    "windows:dev": "scripts\\with-vsdev.cmd npm run tauri -- dev",
    "windows:build": "scripts\\with-vsdev.cmd npm run tauri -- build",
    "mac:dev": "npm run tauri -- dev",
    "mac:build": "npm run tauri -- build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "dompurify": "^3.2.7",
    "marked": "^16.4.1",
    "mermaid": "^11.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
